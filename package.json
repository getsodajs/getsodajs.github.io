  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/starlight": "^0.43.1",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.4",
    "satori": "^0.63.2"
  }
}
