---
const base = import.meta.env.BASE_URL
const command = 'bun create soda'
---

<div class="actions">
  <div class="command">
    <code>{command}</code>
    <button type="button" data-copy={command} aria-label="Copy command">
      <svg class="icon-copy" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
        <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" />
      </svg>
      <svg class="icon-done" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8.5l3.2 3L13 4.5" />
      </svg>
    </button>
  </div>
  <a class="primary" href={`${base}docs/getting-started/`}>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4 1.5h5.5L13 5v9.5H4z" />
      <path d="M9.5 1.5V5H13M6.5 8.5h4M6.5 11h4" />
    </svg>
    Documentation
  </a>
</div>

<style>
  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .command {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    backdrop-filter: blur(10px);
  }

  .command code {
    padding: 0.7rem 0.9rem;
    font-family: var(--mono);
    font-size: 1.125rem;
  }

  .command button {
    display: grid;
    place-items: center;
    width: 2.6rem;
    border: 0;
    border-left: 1px solid var(--border);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .command button:hover {
    color: var(--fg);
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-done,
  .copied .icon-copy {
    display: none;
  }

  .copied .icon-done {
    display: block;
    color: var(--accent);
  }

  .primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #000;
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
  }

  .primary:hover {
    background: #8dff2e;
  }

  .command:focus-within,
  .primary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
